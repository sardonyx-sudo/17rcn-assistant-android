<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- 頂部標題與狀態列 (極簡奶霜色) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_beige"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHeaderRefresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🔄 刷新"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/btn_pill_translucent"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- 內容容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 0. 拍照採集分頁 -->
        <ScrollView
            android:id="@+id/layoutCapture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_capture_photos"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <!-- 照片槽位 (最多 3 張) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center">

                    <!-- 照片 1 -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/photo_slot_border"
                        android:clipToOutline="true"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:id="@+id/ivPhoto1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                        <TextView
                            android:id="@+id/tvEmpty1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="＋ 相片 1"
                            android:textColor="@color/primary_caramel"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                        <ImageButton
                            android:id="@+id/btnRemovePhoto1"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/btn_pill_red"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- 照片 2 -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/photo_slot_border"
                        android:clipToOutline="true"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:id="@+id/ivPhoto2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                        <TextView
                            android:id="@+id/tvEmpty2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="＋ 相片 2"
                            android:textColor="@color/primary_caramel"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                        <ImageButton
                            android:id="@+id/btnRemovePhoto2"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/btn_pill_red"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- 照片 3 -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/photo_slot_border"
                        android:clipToOutline="true">
                        <ImageView
                            android:id="@+id/ivPhoto3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                        <TextView
                            android:id="@+id/tvEmpty3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="＋ 相片 3"
                            android:textColor="@color/primary_caramel"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                        <ImageButton
                            android:id="@+id/btnRemovePhoto3"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/btn_pill_red"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 選擇來源按鈕 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnCaptureCamera"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/btn_take_photo"
                        android:textColor="@color/btn_cta_text"
                        android:background="@drawable/btn_pill_blue"
                        android:layout_marginEnd="6dp"
                        style="?android:attr/borderlessButtonStyle" />

                    <Button
                        android:id="@+id/btnCaptureGallery"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/btn_choose_gallery"
                        android:textColor="@color/btn_cta_text"
                        android:background="@drawable/btn_pill_blue"
                        android:layout_marginStart="6dp"
                        style="?android:attr/borderlessButtonStyle" />
                </LinearLayout>

                <!-- 所在地址 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_capture_address"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etCaptureAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如：台南市安平區永華三街333號6樓-3"
                    android:inputType="textPostalAddress"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/edittext_border" />

                <!-- 備註說明 (選填) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_capture_note"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp" />

                <EditText
                    android:id="@+id/etCaptureNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_capture_note"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:gravity="top"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/edittext_border" />

                <!-- 上傳按鈕 -->
                <Button
                    android:id="@+id/btnSubmitCapture"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_upload_and_recognize"
                    android:textColor="@color/btn_cta_text"
                    android:background="@drawable/btn_pill_green"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    style="?android:attr/borderlessButtonStyle" />

                <ProgressBar
                    android:id="@+id/captureProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCaptureStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- 1. 待刊物資佇列頁面 -->
        <LinearLayout
            android:id="@+id/layoutQueue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/queueProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQueueStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:text="@string/status_loading"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQueue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- 2. 17rcn 網頁操作頁面 (兩行排版操作列) -->
        <LinearLayout
            android:id="@+id/layoutBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 網頁頂部操作懸浮列 (拆為兩行) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_beige"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:orientation="vertical"
                android:elevation="3dp">

                <!-- 第一行：完整物資品名卡片徽章 -->
                <TextView
                    android:id="@+id/tvStagedItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📦 準備刊登：無"
                    android:textColor="@color/badge_text"
                    android:background="@drawable/badge_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="8dp" />

                <!-- 第二行：操作按鈕（填入置中、返回靠右） -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnReinject"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:text="@string/btn_reinject"
                        android:textColor="@color/btn_cta_text"
                        android:background="@drawable/btn_pill_green"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="18dp"
                        style="?android:attr/borderlessButtonStyle" />

                    <Button
                        android:id="@+id/btnBackQueue"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/btn_back_to_queue"
                        android:textColor="@color/btn_blue_text"
                        android:background="@drawable/btn_pill_blue"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:paddingHorizontal="12dp"
                        style="?android:attr/borderlessButtonStyle" />
                </RelativeLayout>
            </LinearLayout>

            <!-- 嵌入式 Chromium WebView -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- 3. 設定頁面 -->
        <ScrollView
            android:id="@+id/layoutSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Apps Script (GAS) 部署網址"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/etGasUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="https://script.google.com/macros/s/.../exec"
                    android:inputType="textUri"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/edittext_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="預設自取地址 (可選填)"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etDefaultAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如：台南市安平區永華三街333號6樓-3"
                    android:inputType="textPostalAddress"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/edittext_border" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_save_settings"
                    android:textColor="@color/btn_cta_text"
                    android:background="@drawable/btn_pill_green"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="24dp"
                    style="?android:attr/borderlessButtonStyle" />

                <!-- 說明卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg"
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 使用說明"
                        android:textColor="@color/badge_text"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. 在「拍照採集」分頁拍攝物資照片後，點擊上傳即可在雲端進行 AI 分析。\n2. 點擊「物資佇列」查看目前待刊登的物資卡片。\n3. 點擊「刊登此物資」將自動切換至 17rcn 刊登網頁並填入完整表單。\n4. 確認資料無誤後，輸入驗證碼並按下送出，系統將自動將 Google 試算表標記為「已刊登」。"
                        android:textColor="@color/badge_text"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- 底部導航欄 (BottomNavigationView) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="#158C6239"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        android:elevation="8dp" />

</LinearLayout>
